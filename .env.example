# Application configuration (prefix APP_)
APP_DATABASE_URL=postgresql+asyncpg://pds:pds@localhost:5432/pds
APP_DB_ECHO=false
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=10
APP_LOG_LEVEL=INFO

# Outbox worker
APP_WORKER_POLL_INTERVAL=1.0
APP_OUTBOX_MAX_ATTEMPTS=5
APP_OUTBOX_BASE_DELAY=1.0
APP_OUTBOX_MAX_DELAY=300.0
APP_READINESS_TIMEOUT=2.0
